<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dream App" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dream App">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="<%= image_path('logo.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= image_path('logo.png') %>">
    <link rel="apple-touch-icon" href="<%= image_path('logo.png') %>">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="mobile-app">
      <div>
        <%= render "shared/flashes" %>

        <% if user_signed_in? %>
          <%= render "shared/menu" %>
        <% end %>

        <%= yield %>
      </div>

      <% if controller_name == "dreams" && action_name == "show" %>
        <%= render "shared/navbar_chat" %>
      <% elsif controller_name == "pages" && action_name == "home" %>
        <%= render "shared/navbar_add" %>
      <% elsif controller_name == "dreams" && action_name == "index" %>
        <%= render "shared/navbar_add" %>
      <% end %>
    </div>
  </body>
</html>
